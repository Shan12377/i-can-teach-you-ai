# n8n Webhook URL for Waitlist and Support forms
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/intake

# Stripe Public Key for Checkout
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# OpenAI API Key (used for generating brand assets, e.g. og-image/logo)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# WaveSpeed API Key
WAVESPEED_API_KEY=wsk_live_your_wavespeed_api_key_here